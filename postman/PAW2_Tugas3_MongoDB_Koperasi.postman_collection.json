  "item": [
    {
      "name": "1. MongoDB Schema & Relations (Referencing & Embedding)",
      "item": [
        {
          "name": "1.1 Get All Members (Referenced Collection)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respons memuat data master anggota\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"status\", \"success\");",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    pm.expect(json.data.length).to.be.at.least(1);",
                  "    pm.environment.set(\"memberId\", json.data[0]._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/members",
              "host": ["{{base_url}}"],
              "path": ["members"]
            }
          }
        },
        {
          "name": "1.2 Create Member (Master Anggota)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Data anggota baru berhasil disimpan di MongoDB\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json.data).to.have.property(\"_id\");",
                  "    pm.expect(json.data.nama).to.eql(\"Hendra Wijaya\");",
                  "    pm.environment.set(\"memberId\", json.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Hendra Wijaya\",\n  \"nik\": \"3205566778890001\",\n  \"noTelepon\": \"081299881122\",\n  \"email\": \"hendra@koperasi.id\",\n  \"alamat\": \"Jl. Pahlawan No. 7, Semarang\",\n  \"statusKeanggotaan\": \"aktif\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/members",
              "host": ["{{base_url}}"],
              "path": ["members"]
            }
          }
        },
        {
          "name": "1.3 Create Loan with Referencing & Embedding",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Terbukti mengimplementasikan REFERENCING ke Anggota\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property(\"anggota\");",
                  "    pm.expect(json.data.anggota).to.be.an(\"object\");",
                  "    pm.expect(json.data.anggota.nama).to.eql(\"Hendra Wijaya\");",
                  "});",
                  "",
                  "pm.test(\"Terbukti mengimplementasikan EMBEDDING Jaminan & Riwayat Pembayaran\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property(\"jaminan\");",
                  "    pm.expect(json.data.jaminan.jenis).to.eql(\"BPKB Honda Beat 2022\");",
                  "    pm.expect(json.data).to.have.property(\"riwayatPembayaran\");",
                  "    pm.expect(json.data.riwayatPembayaran).to.be.an(\"array\");",
                  "    pm.expect(json.data.riwayatPembayaran.length).to.eql(1);",
                  "    pm.environment.set(\"loanId\", json.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"anggota\": \"{{memberId}}\",\n  \"jumlahPinjaman\": 6000000,\n  \"tenorBulan\": 12,\n  \"bungaPersen\": 1.5,\n  \"status\": \"aktif\",\n  \"keterangan\": \"Pinjaman pengadaan alat kerja\",\n  \"jaminan\": {\n    \"jenis\": \"BPKB Honda Beat 2022\",\n    \"nomorDokumen\": \"BPKB-H-9921-SMG\",\n    \"nilaiTaksiran\": 14000000\n  },\n  \"riwayatPembayaran\": [\n    {\n      \"cicilanKe\": 1,\n      \"jumlahBayar\": 550000,\n      \"metodePembayaran\": \"transfer\",\n      \"status\": \"lunas\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/loans",
              "host": ["{{base_url}}"],
              "path": ["loans"]
            }
          }
        },
        {
          "name": "1.4 Get Loan by ID (Populated Referencing & Embedding)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Data pinjaman memuat detail anggota ter-populate dan embedded dokumen\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"_id\");",
                  "    pm.expect(json.anggota).to.have.property(\"nama\");",
                  "    pm.expect(json.jaminan).to.have.property(\"nomorDokumen\");",
                  "    pm.expect(json.riwayatPembayaran).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
