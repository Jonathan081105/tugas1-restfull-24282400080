              "raw": "{\n  \"cicilanKe\": 2,\n  \"jumlahBayar\": 550000,\n  \"metodePembayaran\": \"transfer\",\n  \"status\": \"lunas\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/loans/{{loanId}}/pembayaran",
              "host": ["{{base_url}}"],
              "path": ["loans", "{{loanId}}", "pembayaran"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Endpoint Utama - Filtering, Pagination, Sorting, Projection",
      "item": [
        {
          "name": "2.1 Main Endpoint - Get Loans with Default Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respons memuat objek pagination dan data array\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"pagination\");",
                  "    pm.expect(json.pagination).to.have.property(\"total\");",
                  "    pm.expect(json.pagination).to.have.property(\"page\", 1);",
                  "    pm.expect(json.pagination).to.have.property(\"limit\");",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/loans",
              "host": ["{{base_url}}"],
              "path": ["loans"]
            }
          }
        },
        {
          "name": "2.2 Filtering - Filter by Status (aktif)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Semua data pinjaman berstatus aktif\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.at.least(1);",
                  "    json.data.forEach(function (loan) {",
                  "        pm.expect(loan.status).to.eql(\"aktif\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/loans?status=aktif",
              "host": ["{{base_url}}"],
              "path": ["loans"],
              "query": [
                {
                  "key": "status",
                  "value": "aktif"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Filtering - Filter by Amount Range (5M - 10M)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Semua pinjaman berada pada rentang 5jt s.d 10jt\", function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function (loan) {",
                  "        pm.expect(loan.jumlahPinjaman).to.be.at.least(5000000);",
                  "        pm.expect(loan.jumlahPinjaman).to.be.at.most(10000000);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/loans?minPinjaman=5000000&maxPinjaman=10000000",
              "host": ["{{base_url}}"],
              "path": ["loans"],
              "query": [
                {
                  "key": "minPinjaman",
                  "value": "5000000"
                },
                {
                  "key": "maxPinjaman",
                  "value": "10000000"
                }
              ]
            }
          }
        },
        {
          "name": "2.4 Pagination - Page 1 with Limit 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Metadata pagination halaman 1 sesuai limit 2\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.pagination.page).to.eql(1);",
                  "    pm.expect(json.pagination.limit).to.eql(2);",
                  "    pm.expect(json.data.length).to.eql(2);",
                  "    pm.expect(json.pagination.hasNextPage).to.be.true;",
                  "    pm.expect(json.pagination.hasPrevPage).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/loans?page=1&limit=2",
              "host": ["{{base_url}}"],
              "path": ["loans"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
