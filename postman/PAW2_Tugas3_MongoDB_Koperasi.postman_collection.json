              "raw": "{{base_url}}/loans/{{loanId}}",
              "host": ["{{base_url}}"],
              "path": ["loans", "{{loanId}}"]
            }
          }
        },
        {
          "name": "1.5 Add Payment to Embedded Array",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Array riwayatPembayaran bertambah dalam embedded subdocument\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.riwayatPembayaran.length).to.be.at.least(2);",
                  "    pm.expect(json.data.riwayatPembayaran[1].cicilanKe).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
