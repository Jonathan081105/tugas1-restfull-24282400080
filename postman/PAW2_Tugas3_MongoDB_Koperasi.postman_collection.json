        {
          "name": "2.8 Projection - Specific Fields Only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Hanya field yang diminta pada projection yang dikembalikan\", function () {",
                  "    var json = pm.response.json();",
