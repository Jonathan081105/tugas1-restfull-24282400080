                  "pm.test(\"Pinjaman terurut dari jumlah terkecil ke terbesar\", function () {",
                  "    var json = pm.response.json();",
                  "    for (var i = 0; i < json.data.length - 1; i++) {",
                  "        pm.expect(json.data[i].jumlahPinjaman).to.be.at.most(json.data[i + 1].jumlahPinjaman);",
                  "    }",
